# Dependency Doomsday — every variable is OPTIONAL.
# Copy to .env.local and fill in only what you need. The app runs locally with none of them.

# GitHub personal access token (no scopes needed, public data only).
# Without it, GitHub's public limit is 60 requests/hour per IP; with it, 5,000/hour.
# Create one at https://github.com/settings/tokens (fine-grained, "Public repositories (read-only)").
GITHUB_TOKEN=

# Upstash Redis (free tier) for a shared 24h cache across serverless instances.
# If both are empty, an in-memory LRU cache is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public base URL, used for share links, OG images and badges.
# Defaults to http://localhost:3000 locally and to the Vercel URL when deployed.
NEXT_PUBLIC_SITE_URL=
