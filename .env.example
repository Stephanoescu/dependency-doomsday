# Dependency Doomsday — every variable is OPTIONAL.
# Copy to .env.local and fill in only what you need. The app runs locally with none of them.

# GitHub personal access token (no scopes needed, public data only).
# Without it, GitHub's public limit is 60 requests/hour per IP; with it, 5,000/hour.
# Create one at https://github.com/settings/tokens (fine-grained, "Public repositories (read-only)").
GITHUB_TOKEN=

# Upstash Redis (free tier): shared 24h cache and per-IP rate limits across serverless
# instances. Recommended in production (see README). If both are empty, memory is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public origin for Open Graph / Twitter metadata, e.g. https://doomsday.example
# Defaults to the Vercel production URL when deployed, otherwise http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
